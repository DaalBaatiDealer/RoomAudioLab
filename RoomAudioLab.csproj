<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>RoomAudioLab</AssemblyName>
    <RootNamespace>RoomAudioLab</RootNamespace>
    <Product>Room Audio Lab</Product>
    <AssemblyTitle>Room Audio Lab</AssemblyTitle>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="NAudio" Version="2.2.1" /></ItemGroup>
</Project>
